# @forkexec RTA test: forked calls inherit the full world, push result up
# Self-asserting: PASS lines, exit 1 on first FAIL.

# 1. basic result push-up
@forkexec
define fdouble fn(self) {
  return [$self * 2]
}
if [21.fdouble() == 42] {writeln "PASS fork-basic"} else {syscall proc.exit 1}

# 2. full world: helpers and globals visible (unlike @actor closed world)
set base 100
define addbase fn(self) {
  return [$self + $base]
}
define viahelper fn(self) {
  return [$self.addbase() + 1]
}
@forkexec
define fvia fn(self) {
  return [$self.viahelper()]
}
if [5.fvia() == 106] {writeln "PASS fork-world"} else {syscall proc.exit 1}

# 3. isolation: child writes never leak back
set g "outer"
@forkexec
define fiso proc() {
  set g "inner"
  return $g
}
if [[fiso] == "inner"] {writeln "PASS fork-child-sees"} else {syscall proc.exit 1}
if [$g == "outer"] {writeln "PASS fork-isolation"} else {syscall proc.exit 1}

# 4. errors come back as kind fork, with worker trace
@forkexec
define fboom proc() {
  nosuchcmd_here
}
set r [try {fboom}]
if [$r.none?()] {
  if [$errkind == "fork"] {writeln "PASS fork-err-kind"} else {syscall proc.exit 1}
} else {syscall proc.exit 1}

# 5. retry above fork: each attempt is a fresh worker (marker-file pattern)
syscall fs.remove "tests/marker_fork35.txt"
@retry(2)
@forkexec
define fflaky proc() {
  set m [syscall fs.read "tests/marker_fork35.txt"]
  if [$m.none?()] {
    syscall fs.write "tests/marker_fork35.txt" "1"
    nosuchcmd_first_attempt
  } else {
    return "flaky ok"
  }
}
if [[fflaky] == "flaky ok"] {writeln "PASS fork-retry"} else {syscall proc.exit 1}
syscall fs.remove "tests/marker_fork35.txt"

# 6. retry exhaustion reports kind fork
@retry(2)
@forkexec
define fhopeless proc() {
  nosuchcmd_always
}
set r2 [try {fhopeless}]
if [$r2.none?()] {
  if [$errkind == "fork"] {writeln "PASS fork-retry-exhaust"} else {syscall proc.exit 1}
} else {syscall proc.exit 1}

# 7. typecheck: params rejected pre-spawn (kind type), valid calls run
@typecheck
@forkexec
define fadder proc(x: int, y: int): int {
  return [$x + $y]
}
if [[fadder 3 4] == 7] {writeln "PASS fork-contract-ok"} else {syscall proc.exit 1}
set r3 [try {fadder "3" 4}]
if [$r3.none?()] {
  if [$errkind == "type"] {writeln "PASS fork-contract-param"} else {syscall proc.exit 1}
} else {syscall proc.exit 1}

# 8. tailcall flag crosses into the worker
@tailcallopt
@forkexec
define fcountdown proc(n, acc) {
  if [$n == 0] {return $acc} else {return [fcountdown [$n - 1] [$acc + $n]]}
}
if [[fcountdown 5000 0] == 12502500] {writeln "PASS fork-tailcall"} else {syscall proc.exit 1}

# 9. timeout: generous window unaffected, tight window kills preemptively
@timeout(5000)
@forkexec
define ffast proc(x) {
  return [$x + 1]
}
if [[ffast 41] == 42] {writeln "PASS fork-timeout-fast"} else {syscall proc.exit 1}
@timeout(400)
@forkexec
define fhung proc() {
  loop {set x 1}
}
set r4 [try {fhung}]
if [$r4.none?()] {
  if [$errkind == "timeout"] {writeln "PASS fork-timeout-kill"} else {syscall proc.exit 1}
} else {syscall proc.exit 1}

# 10. misuse negatives (all annotation errors, catchable)
set m1 [try {
@forkexec("x")
define fbad1 proc() {
  return 1
}
}]
if [$m1.none?()] {
  if [$errkind == "annotation"] {writeln "PASS fork-ann-args"} else {syscall proc.exit 1}
} else {syscall proc.exit 1}

set m2 [try {
@actor
@forkexec
define fbad2 proc() {
  return 1
}
}]
if [$m2.none?()] {
  if [$errkind == "annotation"] {writeln "PASS fork-ann-exclusive"} else {syscall proc.exit 1}
} else {syscall proc.exit 1}

set m3 [try {
@forkexec
set badvar 1
}]
if [$m3.none?()] {
  if [$errkind == "annotation"] {writeln "PASS fork-ann-define-only"} else {syscall proc.exit 1}
} else {syscall proc.exit 1}

writeln "forkexec tests done"
