# compile-suite: @timeout (generous window runs, tight window on an
# infinite loop fires deterministically on any machine). Twin case.
@timeout(3000)
define quick proc(x) {
    return [$x * 2]
}
writeln [quick 21]
@timeout(150)
define hanging proc() {
    loop {
        set x 1
    }
    return "never"
}
set r [try {hanging}]
if [$r.none?()] {
    writeln ["timeout-kind: " .. $errkind]
} else {
    writeln "ERROR: should have timed out"
}
@timeout(250)
@retry(2)
define slowsync proc() {
    loop {
        set x 1
    }
    return "never"
}
set r2 [try {slowsync}]
if [$r2.none?()] {
    writeln ["retry-timeout-kind: " .. $errkind]
} else {
    writeln "ERROR: slowsync should have exhausted"
}
writeln "timeout done"
