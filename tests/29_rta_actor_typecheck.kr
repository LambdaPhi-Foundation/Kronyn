# @typecheck x @actor combo: contracts enforced on both sides of the boundary
@typecheck
@actor
define tadd proc(x: int, y: int): int {
    return [$x + $y]
}
writeln [tadd 20 22]
set r [try {[tadd "20" 22]}]
if [$r.none?()] {writeln "boundary param rejected"} else {writeln "ERROR"}

@typecheck
@actor
define fib proc(n: int): int {
    if [$n == 0] {return 0} elif [$n == 1] {return 1} else {return [[fib [$n - 1]] + [fib [$n - 2]]]}
}
writeln [fib 10]

@typecheck
@actor
define badret proc(x: int): int {
    return "not an int"
}
set r2 [try {[badret 1]}]
if [$r2.none?()] {writeln "boundary return rejected"} else {writeln "ERROR"}
writeln "actor+typecheck done"
